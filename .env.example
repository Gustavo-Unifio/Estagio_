DATABASE_URL="file:./dev.db"
# E-mail da conta administrativa inicial.
ADMIN_EMAIL="troque-por-um-email-administrativo"
# Senha exclusiva com pelo menos 12 caracteres.
ADMIN_PASSWORD="troque-por-uma-senha-de-12-ou-mais-caracteres"
SESSION_COOKIE_SECURE="false"
# Origem exata do frontend permitida pela API (necessária em produção).
# APP_ORIGIN="http://localhost:5173"
# E-mail da conta de secretaria criada pelo comando secretary:create.
# SECRETARY_EMAIL="troque-por-um-email-de-secretaria"
# Senha inicial da conta de secretaria, com pelo menos 12 caracteres.
# SECRETARY_PASSWORD="troque-por-uma-senha-de-12-ou-mais-caracteres"
# Nome da pessoa responsável pela conta de secretaria.
# SECRETARY_NAME="troque-por-um-nome"
# Sede autorizada para a conta de secretaria.
# SECRETARY_SEAT="troque-por-uma-sede"
